{
  "name": "besinom",
  "version": "1.0.0",
  "private": true,
  "description": "Besinom: tahlilden tabağa kişisel beslenme rehberi (çevrimdışı, kural tabanlı)",
  "license": "Apache-2.0",
  "scripts": {
    "kontrol": "node scripts/kontrol.mjs",
    "link-kontrol": "node scripts/link-kontrol.mjs",
    "test": "node --test tests/*.test.mjs",
    "ios:sync": "cap sync ios",
    "ios:open": "cap open ios",
    "assets": "capacitor-assets generate --ios",
    "bicim": "npx --yes prettier@3.3.3 --check .",
    "android:sync": "cap sync android",
    "android:open": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.3"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.2"
  }
}
